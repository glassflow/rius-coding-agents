# Environment settings can only turn things OFF. The API key and the server
# it goes to come from /rius:login alone; RIUS_API_KEY and RIUS_ENDPOINT are
# ignored. See the README "Settings" section.

# Uncomment to stop sending prompts, assistant text, tool inputs and tool
# outputs. Structure, model names, token counts, cost and status are still
# sent either way. See the README "What gets sent" section before enabling
# any folder.
# RIUS_CAPTURE_CONTENT=false

# Uncomment to turn tracing off everywhere, whatever the path rules say.
# RIUS_CLAUDE_ENABLED=false
