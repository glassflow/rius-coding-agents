# Rius API key. Required -- without it tracing stays disabled no matter what
# else is configured. A real key looks like ri_xxxxxxxxxxxxxxxxxxxxxxxx.
# Never commit a real value here; this file is checked in as a template.
RIUS_API_KEY=

# Base URL of the Rius ingest endpoint, no path. The plugin appends
# /v1/traces and /v1/heartbeat itself. Defaults to EU production if unset;
# uncomment and point at staging for testing.
# RIUS_ENDPOINT=https://ingest.eu.console.rius-glassflow.com

# Uncomment to stop sending prompts, assistant text, tool inputs and tool
# outputs. Structure, model names, token counts, cost and status are still
# sent either way. See the README "What gets sent" section before enabling
# any folder.
# RIUS_CAPTURE_CONTENT=false
